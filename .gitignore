# Ignore: data, checkpoints, outputs, environments, caches

# Virtual Environment
.venv/
.env
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter
.ipynb_checkpoints/
.jupyter/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# ============================================================================
# PROJECT-SPECIFIC: CHECKPOINTS & DATA (DO NOT COMMIT)
# ============================================================================

# Large model files (checkpoints)
*.pt
*.pth
*.ckpt

# Data (downloaded at runtime)
data/
datasets/

# Assets & Results (training outputs)
assets/
checkpoints/
checkpoints_old/
results/

# Outputs from notebooks
*.gif
*.png
output.png
contents/
outputs/

# Experiment tracking
wandb/
lightning_logs/

# Archive (old checkpoints, outputs, etc.)
notebook_archive/*
